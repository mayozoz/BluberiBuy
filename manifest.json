{
  "manifest_version": 3,
  "name": "BluberiBuy",
  "version": "0.3.0",
  "description": "Track price history on luxury fashion items. Get notified on price drops and low inventory.",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],

  "host_permissions": [
    "https://*.ssense.com/*",
    "https://*.therealreal.com/*",
    "https://*.fashionphile.com/*",
    "https://*.theoutnet.com/*",
    "https://*.vestiairecollective.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.ssense.com/*/product/*",
        "https://*.therealreal.com/products/*",
        "https://*.fashionphile.com/products/*",
        "https://*.theoutnet.com/*/shop/product/*",
        "https://*.theoutnet.com/*/products/*",
        "https://*.vestiairecollective.com/*.shtml",
        "https://*.vestiairecollective.com/*.shtml?*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
