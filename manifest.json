{
  "manifest_version": 3,
  "name": "PriceThread",
  "version": "0.1.0",
  "description": "Track price history on luxury fashion items. Get notified on price drops and low inventory.",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://www.ssense.com/*",
    "https://www.therealreal.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.ssense.com/*/product/*",
        "https://www.therealreal.com/products/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
